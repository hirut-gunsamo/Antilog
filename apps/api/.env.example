# Database connection used by the API and Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sim_management"

# Signs login tokens. Use a long random string; never reuse this example.
JWT_SECRET="change-me-to-a-long-random-string"

# Where the API listens.
PORT=3000

# Web Push (phone notifications). Generate with: npx web-push generate-vapid-keys
# Leave empty to turn phone notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
