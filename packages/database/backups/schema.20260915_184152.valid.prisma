generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  SUPERVISOR
  SALES
}

enum ProductCategory {
  SIM_CARD
  AIRTIME_VOUCHER
  PHONE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryUnitStatus {
  IN_STOCK
  RESERVED
  SOLD
  DAMAGED
  LOST
}

enum LocationType {
  WAREHOUSE
  SUPERVISOR
  SALES
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SENT_TO_OWNER
}

enum ReceiptStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  TRANSFER
  SALE
  RETURN
  ADJUSTMENT
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum SyncStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)

  supervisorId String?
  supervisor   User?   @relation("SupervisorSales", fields: [supervisorId], references: [id])
  salesMembers User[]  @relation("SupervisorSales")

  stockLocation StockLocation?

  requestsCreated  StockRequest[] @relation("RequestsCreated")
  requestsReceived StockRequest[] @relation("RequestsReceived")
  requestsApproved StockRequest[] @relation("RequestsApproved")

  transfersDelivered StockTransfer[] @relation("TransfersDelivered")
  transfersReceived  StockTransfer[] @relation("TransfersReceived")

  salesCreated  Sale[] @relation("SalesCreated")
  salesApproved Sale[] @relation("SalesApproved")

  cashReports         CashReport[] @relation("CashReportsCreated")
  cashReportsApproved CashReport[] @relation("CashReportsApproved")

  receiptsUploaded BankReceipt[] @relation("ReceiptsUploaded")
  receiptsVerified BankReceipt[] @relation("ReceiptsVerified")

  stockMovements StockMovement[]

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([supervisorId])
}

model Product {
  id          String          @id @default(cuid())
  sku         String          @unique
  name        String
  category    ProductCategory
  description String?
  price       Decimal         @db.Decimal(12, 2)
  status      ProductStatus   @default(ACTIVE)

  simDetails     SimProduct?
  voucherDetails VoucherProduct?
  phoneDetails   PhoneProduct?

  inventoryBalances InventoryBalance[]
  inventoryUnits    InventoryUnit[]

  requestItems   StockRequestItem[]
  transferItems  StockTransferItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model SimProduct {
  id        String @id @default(cuid())
  productId String @unique

  network String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VoucherProduct {
  id        String @id @default(cuid())
  productId String @unique

  denomination Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([denomination])
}

model PhoneProduct {
  id        String @id @default(cuid())
  productId String @unique

  brand   String
  model   String
  storage String?
  color   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
  @@index([model])
}

model StockLocation {
  id   String       @id @default(cuid())
  name String
  type LocationType

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  balances InventoryBalance[]
  units    InventoryUnit[]

  transfersFrom StockTransfer[] @relation("TransferFromLocation")
  transfersTo   StockTransfer[] @relation("TransferToLocation")

  sales Sale[]

  movementsFrom StockMovement[] @relation("MovementFromLocation")
  movementsTo   StockMovement[] @relation("MovementToLocation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model InventoryBalance {
  id String @id @default(cuid())

  locationId String
  productId  String

  quantity Int @default(0)

  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, productId])
  @@index([productId])
}

model InventoryUnit {
  id String @id @default(cuid())

  productId  String
  locationId String

  status InventoryUnitStatus @default(IN_STOCK)

  serialNumber String? @unique

  // SIM-specific
  simNumber String? @unique
  iccid     String? @unique

  // Phone-specific
  imei String? @unique

  saleItemId String?

  product Product @relation(fields: [productId], references: [id])

  location StockLocation @relation(fields: [locationId], references: [id])

  saleItem SaleItem? @relation(fields: [saleItemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([locationId])
  @@index([status])
}

model StockRequest {
  id String @id @default(cuid())

  requestedById String
  requestedToId String

  approvedById String?

  status RequestStatus @default(PENDING)

  notes           String?
  rejectionReason String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  fulfilledAt DateTime?

  requestedBy User @relation("RequestsCreated", fields: [requestedById], references: [id])

  requestedTo User @relation("RequestsReceived", fields: [requestedToId], references: [id])

  approvedBy User? @relation("RequestsApproved", fields: [approvedById], references: [id])

  items StockRequestItem[]

  transfer StockTransfer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestedById])
  @@index([requestedToId])
  @@index([status])
}

model StockRequestItem {
  id String @id @default(cuid())

  requestId String
  productId String

  quantity Int

  request StockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([productId])
}

model StockTransfer {
  id String @id @default(cuid())

  requestId String? @unique

  fromLocationId String
  toLocationId   String

  deliveredById String?
  receivedById  String?

  status TransferStatus @default(PENDING)

  notes String?

  shippedAt  DateTime?
  receivedAt DateTime?

  request StockRequest? @relation(fields: [requestId], references: [id])

  fromLocation StockLocation @relation("TransferFromLocation", fields: [fromLocationId], references: [id])

  toLocation StockLocation @relation("TransferToLocation", fields: [toLocationId], references: [id])

  deliveredBy User? @relation("TransfersDelivered", fields: [deliveredById], references: [id])

  receivedBy User? @relation("TransfersReceived", fields: [receivedById], references: [id])

  items StockTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
}

model StockTransferItem {
  id String @id @default(cuid())

  transferId String
  productId  String

  quantity Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([transferId])
  @@index([productId])
}

model Sale {
  id String @id @default(cuid())

  salespersonId String
  locationId    String

  cashReportId String?

  status SaleStatus @default(DRAFT)

  subtotal     Decimal @db.Decimal(12, 2)
  totalAmount  Decimal @db.Decimal(12, 2)
  cashReceived Decimal @db.Decimal(12, 2)

  approvedById String?

  notes String?

  saleDate    DateTime  @default(now())
  submittedAt DateTime?
  approvedAt  DateTime?

  salesperson User @relation("SalesCreated", fields: [salespersonId], references: [id])

  approvedBy User? @relation("SalesApproved", fields: [approvedById], references: [id])

  location StockLocation @relation(fields: [locationId], references: [id])

  cashReport CashReport? @relation(fields: [cashReportId], references: [id])

  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salespersonId])
  @@index([saleDate])
  @@index([status])
  @@index([cashReportId])
}

model SaleItem {
  id String @id @default(cuid())

  saleId    String
  productId String

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  inventoryUnits InventoryUnit[]

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

model CashReport {
  id String @id @default(cuid())

  salespersonId String

  periodStart DateTime
  periodEnd   DateTime

  expectedCash Decimal @db.Decimal(12, 2)
  actualCash   Decimal @db.Decimal(12, 2)
  variance     Decimal @db.Decimal(12, 2)

  status ReportStatus @default(DRAFT)

  approvedById String?

  notes           String?
  rejectionReason String?

  submittedAt   DateTime?
  approvedAt    DateTime?
  sentToOwnerAt DateTime?

  salesperson User @relation("CashReportsCreated", fields: [salespersonId], references: [id])

  approvedBy User? @relation("CashReportsApproved", fields: [approvedById], references: [id])

  sales Sale[]

  receipts BankReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salespersonId])
  @@index([periodStart, periodEnd])
  @@index([status])
}

model BankReceipt {
  id String @id @default(cuid())

  cashReportId String?

  uploadedById String
  verifiedById String?

  bankName        String?
  referenceNumber String?
  fileUrl         String

  amount Decimal @db.Decimal(12, 2)

  receiptDate DateTime

  status ReceiptStatus @default(PENDING)

  notes String?

  cashReport CashReport? @relation(fields: [cashReportId], references: [id])

  uploadedBy User @relation("ReceiptsUploaded", fields: [uploadedById], references: [id])

  verifiedBy User? @relation("ReceiptsVerified", fields: [verifiedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cashReportId])
  @@index([receiptDate])
  @@index([status])
}

model StockMovement {
  id String @id @default(cuid())

  productId String

  fromLocationId String?
  toLocationId   String?

  quantity Int

  type StockMovementType

  referenceType String?
  referenceId   String?

  createdById String?

  notes String?

  product Product @relation(fields: [productId], references: [id])

  fromLocation StockLocation? @relation("MovementFromLocation", fields: [fromLocationId], references: [id])

  toLocation StockLocation? @relation("MovementToLocation", fields: [toLocationId], references: [id])

  createdBy User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id String @id @default(cuid())

  actorId String?

  action     String
  entityType String
  entityId   String?

  oldData Json?
  newData Json?

  ipAddress String?
  userAgent String?

  actor User? @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model SyncRecord {
  id String @id @default(cuid())

  clientMutationId String @unique
  deviceId         String

  entityType String
  entityId   String?

  operation SyncOperation
  status    SyncStatus    @default(PENDING)

  payload Json?

  errorMessage String?

  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId])
  @@index([status])
  @@index([createdAt])
}
