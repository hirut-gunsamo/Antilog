generator client {
  provider = "prisma-client-js"

  // Generated into the repo rather than node_modules/.pnpm. VS Code watches
  // workspace files reliably but misses pnpm's deep symlinked store, which
  // left the editor showing pre-migration types after every `prisma generate`.
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  SUPERVISOR
  SALES
}

enum ProductCategory {
  SIM_CARD
  AIRTIME_VOUCHER
  PHONE
  /// Goods in a category the Owner added: counted and sold by quantity and
  /// price, no serial numbers or value.
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryUnitStatus {
  IN_STOCK
  RESERVED
  SOLD
  DAMAGED
  LOST
}

enum LocationType {
  WAREHOUSE
  SUPERVISOR
  SALES
}

/// What a stock request is for. RESTOCK moves stock between branches; ISSUE
/// and RETURN move it between a branch and one salesperson's own hands at the
/// start and end of their day.
enum StockRequestKind {
  RESTOCK
  ISSUE
  RETURN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SENT_TO_OWNER
}

enum ReceiptStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  TRANSFER
  SALE
  RETURN
  ADJUSTMENT
}

// Why stock left without being sold. Damaged goods still physically exist;
// lost ones do not. They are written off the same way but reconcile
// differently, so the distinction is kept rather than lumped into one word.
enum StockLossKind {
  DAMAGED
  LOST
}

enum StockLossStatus {
  PENDING
  APPROVED
  REJECTED
}

/// What kind of office equipment an asset is. Not product categories: these
/// are things the branch works with, never things it sells.
enum AssetCategory {
  ELECTRONICS
  FURNITURE
  STATIONERY
  OTHER
}

/// Where an asset is in its life. Damaged equipment still sits in the branch
/// and still has to be accounted for; retired equipment has left for good.
enum AssetStatus {
  IN_USE
  DAMAGED
  RETIRED
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum SyncStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)

  /// Contact number. Nullable only because users predating the column have
  /// none; the API requires one when creating a user.
  phone String?

  /// What the Owner pays this person a month. Null: not on payroll yet.
  monthlySalary Decimal? @db.Decimal(12, 2)

  // Branch membership. OWNER is org-wide and has no branch (null);
  // SUPERVISOR and SALES always belong to exactly one branch.
  // A SALES user's supervisor is derived: the active SUPERVISOR of the same branch.
  branchId String?
  branch   StockLocation? @relation(fields: [branchId], references: [id])

  settingsUpdated  AppSetting[]   @relation("SettingsUpdatedBy")
  requestsCreated  StockRequest[] @relation("RequestsCreated")
  requestsReceived StockRequest[] @relation("RequestsReceived")
  requestsApproved StockRequest[] @relation("RequestsApproved")

  transfersDelivered StockTransfer[] @relation("TransfersDelivered")
  transfersReceived  StockTransfer[] @relation("TransfersReceived")

  salesCreated  Sale[] @relation("SalesCreated")
  salesApproved Sale[] @relation("SalesApproved")

  cashReports         CashReport[] @relation("CashReportsCreated")
  cashReportsApproved CashReport[] @relation("CashReportsApproved")

  receiptsUploaded BankReceipt[] @relation("ReceiptsUploaded")
  receiptsVerified BankReceipt[] @relation("ReceiptsVerified")

  lossesReported StockLossReport[] @relation("LossReported")
  lossesReviewed StockLossReport[] @relation("LossReviewed")

  nationalIdRecords NationalIdRecord[]     @relation("NationalIdRecorded")
  nationalIdStock   NationalIdStockEntry[] @relation("NationalIdStockReceived")
  assetsRecorded    OfficeAsset[]          @relation("AssetsRecorded")

  stockMovements StockMovement[]

  /// What this salesperson currently holds to sell today.
  holdings SalespersonHolding[]

  cashCollected   CashCollection[] @relation("CashCollected")
  cashHandedOver  CashCollection[] @relation("CashHandedOver")

  auditLogs AuditLog[]

  pushSubscriptions PushSubscription[]
  ibidLoads         IbidLoad[]  @relation("IbidLoads")
  ibidPrints        IbidPrint[] @relation("IbidPrints")
  commissionRates   CommissionRate[]
  payrollPayments   PayrollPayment[] @relation("PayrollPaid")
  payrollRecorded   PayrollPayment[] @relation("PayrollRecorded")
  commissionsPaid   CommissionPayment[] @relation("CommissionPaid")
  commissionsRecorded CommissionPayment[] @relation("CommissionRecorded")
  telebirrLoads     TelebirrLoad[]
  telebirrRecorded  TelebirrTransaction[]
  expensesRecorded  Expense[]
  nidRequests       NationalIdRequest[] @relation("NidRequested")
  nidForwarded      NationalIdRequest[] @relation("NidForwarded")
  nidReturned       NationalIdRequest[] @relation("NidReturned")
  nidOrders         NationalIdOrder[]
  banksAdded        Bank[]            @relation("BanksAdded")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([branchId])
  @@index([branchId, role, isActive])
}

model Product {
  id          String          @id @default(cuid())
  sku         String          @unique
  name        String
  category    ProductCategory
  description String?
  price       Decimal         @db.Decimal(12, 2)
  status      ProductStatus   @default(ACTIVE)

  typeId String?
  type   ProductType? @relation(fields: [typeId], references: [id])

  /// The Owner's category; `category` above is its kind.
  categoryId      String?
  productCategory Category? @relation(fields: [categoryId], references: [id])

  simDetails     SimProduct?
  voucherDetails VoucherProduct?
  phoneDetails   PhoneProduct?

  inventoryBalances InventoryBalance[]
  inventoryUnits    InventoryUnit[]
  lossReports       StockLossReport[]

  requestItems   StockRequestItem[]
  transferItems  StockTransferItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  holdings       SalespersonHolding[]
  commissionLines CommissionLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
}

/// A brand, a voucher type, or a phone model — the level between a fixed
/// category and a sellable product. Self-referencing so phones can go
/// brand -> model while SIM and voucher types stay one level deep.
model ProductType {
  id String @id @default(cuid())

  category ProductCategory
  parentId String?
  name     String

  /// The Owner's category; `category` above is its kind.
  categoryId      String?
  productCategory Category? @relation(fields: [categoryId], references: [id])

  isActive Boolean @default(true)

  parent   ProductType?  @relation("ProductTypeTree", fields: [parentId], references: [id])
  children ProductType[] @relation("ProductTypeTree")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, parentId, name])
  @@index([category])
  @@index([categoryId])
  @@index([parentId])
}

model SimProduct {
  id        String @id @default(cuid())
  productId String @unique

  /// Ethio Telecom is the only network, so the form no longer asks. Kept
  /// nullable rather than dropped so existing rows keep their value.
  network String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VoucherProduct {
  id        String @id @default(cuid())
  productId String @unique

  denomination Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([denomination])
}

model PhoneProduct {
  id        String @id @default(cuid())
  productId String @unique

  brand   String
  model   String
  storage String?
  color   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
  @@index([model])
}

model StockLocation {
  id   String       @id @default(cuid())
  name String       @unique
  type LocationType

  // A branch that can act as a stock source for other branches. More than one
  // is allowed; at least one must always exist and be active. A main-stock
  // branch is still an ordinary selling branch.
  isMainStock Boolean @default(false)

  // Closed branches are deactivated, never deleted, so their sales history
  // and reports stay intact.
  isActive Boolean @default(true)

  // A branch holds many users: one active SUPERVISOR plus any number of SALES.
  users User[]

  balances InventoryBalance[]
  units    InventoryUnit[]

  transfersFrom StockTransfer[] @relation("TransferFromLocation")
  transfersTo   StockTransfer[] @relation("TransferToLocation")

  sales Sale[]

  lossReports StockLossReport[]

  movementsFrom StockMovement[] @relation("MovementFromLocation")
  movementsTo   StockMovement[] @relation("MovementToLocation")

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  nationalIdRecords NationalIdRecord[]
  nationalIdStock   NationalIdStockEntry[]
  officeAssets      OfficeAsset[]
  bankReceipts      BankReceipt[]
  ibidPrints        IbidPrint[]
  telebirrTransactions TelebirrTransaction[]
  expenses          Expense[]
  nidRequests       NationalIdRequest[]
  nidOrders         NationalIdOrder[]

  @@index([type])
}

model InventoryBalance {
  id String @id @default(cuid())

  locationId String
  productId  String

  quantity Int @default(0)

  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, productId])
  @@index([productId])
}

model InventoryUnit {
  id String @id @default(cuid())

  productId  String
  locationId String

  status InventoryUnitStatus @default(IN_STOCK)

  serialNumber String? @unique

  // SIM-specific
  simNumber String? @unique
  iccid     String? @unique

  // Phone-specific
  imei String? @unique

  saleItemId String?

  // Set while a write-off is pending or approved; cleared if it is rejected.
  lossReportId String?

  product Product @relation(fields: [productId], references: [id])

  location StockLocation @relation(fields: [locationId], references: [id])

  saleItem SaleItem? @relation(fields: [saleItemId], references: [id])

  lossReport StockLossReport? @relation(fields: [lossReportId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([locationId])
  @@index([status])
  @@index([lossReportId])
}

model StockRequest {
  id String @id @default(cuid())

  kind StockRequestKind @default(RESTOCK)

  requestedById String
  requestedToId String

  approvedById String?

  status RequestStatus @default(PENDING)

  notes           String?
  rejectionReason String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  fulfilledAt DateTime?

  requestedBy User @relation("RequestsCreated", fields: [requestedById], references: [id])

  requestedTo User @relation("RequestsReceived", fields: [requestedToId], references: [id])

  approvedBy User? @relation("RequestsApproved", fields: [approvedById], references: [id])

  items StockRequestItem[]

  transfer StockTransfer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestedById])
  @@index([requestedToId])
  @@index([status])
  @@index([kind])
}

/// Cash handed from a salesperson to their supervisor during the day.
///
/// The supervisor banks it and uploads the receipt, so the money's journey is
/// sale -> salesperson -> supervisor -> bank. Each leg is recorded, which is
/// what makes "who is holding how much right now" answerable at any moment,
/// including the yadere left over after the bank shuts.
model CashCollection {
  id String @id @default(cuid())

  supervisorId  String
  salespersonId String

  amount Decimal @db.Decimal(12, 2)

  collectedAt DateTime @default(now())

  notes String?

  supervisor  User @relation("CashCollected", fields: [supervisorId], references: [id])
  salesperson User @relation("CashHandedOver", fields: [salespersonId], references: [id])

  createdAt DateTime @default(now())

  @@index([supervisorId])
  @@index([salespersonId])
  @@index([collectedAt])
}

/// What one salesperson currently has in their hands to sell.
///
/// The goods are still standing in the branch — selling happens at the office
/// — so this does not move `InventoryBalance`. It records who is answerable
/// for what: raised when a morning ISSUE request is approved, reduced by each
/// sale, and cleared when the evening RETURN request is approved.
model SalespersonHolding {
  id String @id @default(cuid())

  userId    String
  productId String

  quantity Int @default(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model StockRequestItem {
  id String @id @default(cuid())

  requestId String
  productId String

  // What was asked for. Never changed after the request is raised.
  quantity Int

  // What the reviewer agreed to send: 0..quantity. Null until the request is
  // approved. The transfer ships this amount, not `quantity`.
  approvedQuantity Int?

  request StockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([productId])
}

model StockTransfer {
  id String @id @default(cuid())

  requestId String? @unique

  fromLocationId String
  toLocationId   String

  deliveredById String?
  receivedById  String?

  status TransferStatus @default(PENDING)

  notes String?

  /// Who is carrying the goods, named by the Owner when they approve the
  /// restock. The receiving branch checks the person and the plate against
  /// these before unloading, so a delivery cannot be handed to the wrong van.
  /// Nullable only because transfers made before this was recorded have none.
  driverName  String?
  driverPhone String?
  vehiclePlate String?

  shippedAt  DateTime?
  receivedAt DateTime?

  request StockRequest? @relation(fields: [requestId], references: [id])

  fromLocation StockLocation @relation("TransferFromLocation", fields: [fromLocationId], references: [id])

  toLocation StockLocation @relation("TransferToLocation", fields: [toLocationId], references: [id])

  deliveredBy User? @relation("TransfersDelivered", fields: [deliveredById], references: [id])

  receivedBy User? @relation("TransfersReceived", fields: [receivedById], references: [id])

  items StockTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
}

model StockTransferItem {
  id String @id @default(cuid())

  transferId String
  productId  String

  quantity Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([transferId])
  @@index([productId])
}

/// A bank a transfer sale can name. Seeded with Ethiopia's banks; staff add
/// more from the sale form. Names are unique ignoring case (index in SQL).
model Bank {
  id          String   @id @default(cuid())
  name        String
  sortOrder   Int      @default(1000)
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation("BanksAdded", fields: [createdById], references: [id], onDelete: SetNull)
}

enum PaymentMethod {
  CASH
  TRANSFER
}

model Sale {
  id String @id @default(cuid())

  salespersonId String
  locationId    String

  cashReportId String?

  status SaleStatus @default(DRAFT)

  subtotal     Decimal @db.Decimal(12, 2)
  totalAmount  Decimal @db.Decimal(12, 2)
  cashReceived Decimal @db.Decimal(12, 2)

  /// Cash or bank transfer. Transfer money is in transferReceived, never in
  /// cashReceived, so it does not count as cash the seller holds.
  paymentMethod    PaymentMethod @default(CASH)
  bankName         String?
  transferReceived Decimal       @default(0) @db.Decimal(12, 2)

  approvedById String?

  notes String?

  saleDate    DateTime  @default(now())
  submittedAt DateTime?
  approvedAt  DateTime?

  salesperson User @relation("SalesCreated", fields: [salespersonId], references: [id])

  approvedBy User? @relation("SalesApproved", fields: [approvedById], references: [id])

  location StockLocation @relation(fields: [locationId], references: [id])

  cashReport CashReport? @relation(fields: [cashReportId], references: [id])

  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salespersonId])
  @@index([saleDate])
  @@index([status])
  @@index([cashReportId])
}

model SaleItem {
  id String @id @default(cuid())

  saleId    String
  productId String

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  inventoryUnits InventoryUnit[]

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

model CashReport {
  id String @id @default(cuid())

  salespersonId String

  periodStart DateTime
  periodEnd   DateTime

  expectedCash Decimal @db.Decimal(12, 2)
  actualCash   Decimal @db.Decimal(12, 2)
  variance     Decimal @db.Decimal(12, 2)

  status ReportStatus @default(DRAFT)

  approvedById String?

  notes           String?
  rejectionReason String?

  submittedAt   DateTime?
  approvedAt    DateTime?
  sentToOwnerAt DateTime?

  salesperson User @relation("CashReportsCreated", fields: [salespersonId], references: [id])

  approvedBy User? @relation("CashReportsApproved", fields: [approvedById], references: [id])

  sales Sale[]

  receipts BankReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salespersonId])
  @@index([periodStart, periodEnd])
  @@index([status])
}

model BankReceipt {
  id String @id @default(cuid())

  cashReportId String?

  uploadedById String
  verifiedById String?

  bankName        String?
  referenceNumber String?
  /// Optional: bankers often credit the account through their app and no
  /// slip is given.
  fileUrl         String?

  amount Decimal @db.Decimal(12, 2)

  /// The branch whose takings were credited.
  locationId String?
  location   StockLocation? @relation(fields: [locationId], references: [id])

  /// That day's sales for the branch when this was entered, and what was
  /// left uncredited after it ("yadere", kept overnight).
  daySales Decimal? @db.Decimal(12, 2)
  yadere   Decimal? @db.Decimal(12, 2)

  receiptDate DateTime

  status ReceiptStatus @default(PENDING)

  notes String?

  cashReport CashReport? @relation(fields: [cashReportId], references: [id])

  uploadedBy User @relation("ReceiptsUploaded", fields: [uploadedById], references: [id])

  verifiedBy User? @relation("ReceiptsVerified", fields: [verifiedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cashReportId])
  @@index([locationId])
  @@index([receiptDate])
  @@index([status])
}

model StockMovement {
  id String @id @default(cuid())

  productId String

  fromLocationId String?
  toLocationId   String?

  quantity Int

  type StockMovementType

  referenceType String?
  referenceId   String?

  createdById String?

  notes String?

  product Product @relation(fields: [productId], references: [id])

  fromLocation StockLocation? @relation("MovementFromLocation", fields: [fromLocationId], references: [id])

  toLocation StockLocation? @relation("MovementToLocation", fields: [toLocationId], references: [id])

  createdBy User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id String @id @default(cuid())

  actorId String?

  action     String
  entityType String
  entityId   String?

  oldData Json?
  newData Json?

  ipAddress String?
  userAgent String?

  actor User? @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

/**
 * A write-off waiting to be confirmed.
 * Reporting one takes the stock out of the sellable pool straight away — a
 * broken SIM must not be sold while a supervisor gets round to it — but the
 * report stays PENDING until reviewed. Approval confirms the write-off;
 * rejection puts the stock back. Shrinkage is a fraud route, so the person
 * who reports is never the person who signs it off.
 */
/**
 * A day's National ID print work at one branch.
 * Not inventory: nothing is bought, held or sold. It is a service the branch
 * performs, so it is counted rather than stocked.
 * Original and copy prints are kept as separate counts, never collapsed into
 * one total, because they are separate lines in the branch's own books and can
 * be charged differently.
 */
/**
 * Blank ID cards received by a branch.
 * Deliberately a log of arrivals rather than a running balance column: what is
 * left is worked out as (received − printed) whenever it is asked for, so
 * correcting or deleting a day's print work fixes the remaining figure by
 * itself. There is no second number to drift out of step with the first.
 * This lives with National ID rather than with Inventory because blanks are
 * consumable supply for one service, not stock the branch sells.
 */
/// Office equipment sent to a branch: computers, printers, desks, paper.
///
/// Deliberately separate from `Product` and `InventoryBalance`, which are
/// about goods the business buys to sell. A printer is never sold, never
/// issued to a salesperson and never appears in takings, so mixing the two
/// would put desks in the sales reports.
///
/// One row is one delivery of one kind of thing: five chairs delivered to
/// Balela on a date is a row with quantity 5. Serialised equipment is
/// recorded one row per item, so its serial number identifies exactly one
/// machine.
model OfficeAsset {
  id String @id @default(cuid())

  locationId String

  name     String
  category AssetCategory
  status   AssetStatus   @default(IN_USE)

  quantity Int @default(1)

  /// For equipment that carries one: a laptop's service tag, a printer's
  /// serial. Free text because manufacturers agree on no format.
  serialNumber String?

  /// What it cost, when that is known. Optional: donated and inherited
  /// equipment has no price, and a missing figure is honest where a zero
  /// would not be.
  cost Decimal? @db.Decimal(12, 2)

  /// The day it reached the branch, which is not always the day it was typed
  /// into the system.
  receivedAt DateTime @default(now())

  note String?

  recordedById String

  location   StockLocation @relation(fields: [locationId], references: [id])
  recordedBy User          @relation("AssetsRecorded", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([category])
  @@index([status])
  @@index([receivedAt])
}

model NationalIdStockEntry {
  id String @id @default(cuid())

  locationId String

  originalAdded Int @default(0)
  copyAdded     Int @default(0)

  note String?

  receivedById String

  location   StockLocation @relation(fields: [locationId], references: [id])
  receivedBy User          @relation("NationalIdStockReceived", fields: [receivedById], references: [id])

  createdAt DateTime @default(now())

  @@index([locationId])
  @@index([createdAt])
}

model NationalIdRecord {
  id String @id @default(cuid())

  /// The day the work was done, which is not always the day it was entered.
  date DateTime @db.Date

  locationId   String
  recordedById String

  originalCount Int @default(0)
  copyCount     Int @default(0)

  /// The rates in force when this was recorded, copied onto the row. Changing
  /// the rate later must not silently rewrite what past days earned.
  originalRate Decimal @db.Decimal(12, 2)
  copyRate     Decimal @db.Decimal(12, 2)

  /// originalCount * originalRate + copyCount * copyRate, worked out on the
  /// server so the client can never disagree with the books.
  revenue Decimal @db.Decimal(14, 2)

  notes String?

  location   StockLocation @relation(fields: [locationId], references: [id])
  recordedBy User          @relation("NationalIdRecorded", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([date])
  @@index([recordedById])
}

model StockLossReport {
  id String @id @default(cuid())

  kind   StockLossKind
  status StockLossStatus @default(PENDING)

  productId  String
  locationId String

  quantity Int

  reason String

  reportedById String
  reviewedById String?

  reviewedAt      DateTime?
  rejectionReason String?

  product  Product       @relation(fields: [productId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])

  reportedBy User  @relation("LossReported", fields: [reportedById], references: [id])
  reviewedBy User? @relation("LossReviewed", fields: [reviewedById], references: [id])

  // Named units for serialised stock. Airtime vouchers are not serialised, so
  // for those the quantity above is the whole of it.
  units InventoryUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([status])
  @@index([reportedById])
  @@index([createdAt])
}

model SyncRecord {
  id String @id @default(cuid())

  clientMutationId String @unique
  deviceId         String

  entityType String
  entityId   String?

  operation SyncOperation
  status    SyncStatus    @default(PENDING)

  payload Json?

  errorMessage String?

  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId])
  @@index([status])
  @@index([createdAt])
}

/// Organisation-wide settings. Exactly one row, pinned by a fixed id, so the
/// app can read it without first asking which one it wants. Only the Owner
/// writes it.
model AppSetting {
  /// Always "app". The check constraint in the migration enforces it, which is
  /// what keeps this table a singleton.
  id String @id @default("app")

  systemName String @default("AntiLog")

  /// The language a user sees before choosing one for themselves.
  defaultLanguage String @default("en")

  /// ISO 4217. Display only — no conversion happens anywhere.
  currency String @default("ETB")

  /// Named formats the client knows how to render; not strftime patterns.
  dateFormat String @default("medium")
  timeFormat String @default("24h")

  /// Default rows per page. A user may still override it in their browser.
  itemsPerPage Int @default(10)

  /// What a branch charges per National ID print. Optional in the sense that
  /// zero is allowed — a branch that does not charge still records the counts.
  nationalIdOriginalRate Decimal @default(5) @db.Decimal(12, 2)
  nationalIdCopyRate     Decimal @default(5) @db.Decimal(12, 2)

  /// When a salesperson is running low on what they took out, per kind of
  /// goods. Set per category because the numbers are not comparable: five
  /// phones is a lot to be holding, five vouchers is nearly nothing. Warned at
  /// or below these, so they can ask for more before a customer is turned away.
  lowHoldingSim     Int @default(5)
  lowHoldingPhone   Int @default(2)
  lowHoldingVoucher Int @default(20)

  /// In-app notification switches. No delivery mechanism exists yet; these
  /// record the intent so the UI is not inventing its own state.
  notifySales     Boolean @default(true)
  notifyRequests  Boolean @default(true)
  notifyApprovals Boolean @default(true)
  notifyLowStock  Boolean @default(true)
  notifySystem    Boolean @default(false)

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SettingsUpdatedBy", fields: [updatedById], references: [id])
}

/// A phone that has allowed notifications for this user. The server pushes to
/// it when the user's to-do count goes up, so new work is heard about with the
/// app closed. `lastCount` and `lastLatestAt` remember what was last pushed so
/// the same thing is not sent twice.
model PushSubscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  /// "en" or "am": the language the app was in when it was turned on.
  lang String @default("en")

  lastCount    Int       @default(0)
  lastLatestAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Birr the Owner loads into the main Ibid (digital airtime) balance.
model IbidLoad {
  id String @id @default(cuid())

  amount Decimal @db.Decimal(14, 2)
  note   String?

  createdById String
  createdBy   User   @relation("IbidLoads", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Ibid cards a branch printed: one value, a birr amount, taken off the main
/// balance. `cards` is amount / denomination. Printing is not a sale.
model IbidPrint {
  id String @id @default(cuid())

  locationId String
  location   StockLocation @relation(fields: [locationId], references: [id])

  denomination Int
  amount       Decimal @db.Decimal(14, 2)
  cards        Int
  note         String?

  printedById String
  printedBy   User   @relation("IbidPrints", fields: [printedById], references: [id])

  createdAt DateTime @default(now())

  @@index([locationId])
  @@index([createdAt])
}

/// Commission the Owner sets per product category: PERCENT of sales, or
/// PER_UNIT birr per item sold. userId null is the rate for everyone; set, it
/// is one employee's own rate and wins over the everyone-rate.
model CommissionRate {
  id String @id @default(cuid())

  category ProductCategory
  userId   String?
  user     User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind  String
  value Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, userId])
}

/// What one employee was paid for one month, as the figures stood then.
model PayrollPayment {
  id String @id @default(cuid())

  userId String
  user   User   @relation("PayrollPaid", fields: [userId], references: [id])

  /// "2026-09"
  month String

  salary     Decimal @db.Decimal(12, 2)
  commission Decimal @db.Decimal(12, 2)
  bonus      Decimal @default(0) @db.Decimal(12, 2)
  deduction  Decimal @default(0) @db.Decimal(12, 2)
  net        Decimal @db.Decimal(12, 2)
  note       String?

  paidById String
  paidBy   User     @relation("PayrollRecorded", fields: [paidById], references: [id])
  paidAt   DateTime @default(now())

  @@unique([userId, month])
  @@index([month])
}

/// Commission the Owner paid one employee for a month, one line per item.
model CommissionPayment {
  id String @id @default(cuid())

  userId String
  user   User   @relation("CommissionPaid", fields: [userId], references: [id])

  /// "2026-09"
  month String
  total Decimal @db.Decimal(12, 2)
  note  String?

  lines CommissionLine[]

  paidById String
  paidBy   User     @relation("CommissionRecorded", fields: [paidById], references: [id])
  paidAt   DateTime @default(now())

  @@index([month])
  @@index([userId])
}

model CommissionLine {
  id String @id @default(cuid())

  paymentId String
  payment   CommissionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  category ProductCategory
  /// The Owner's category this was paid on (null for National ID), and the
  /// name it was paid under.
  categoryId       String?
  commissionOnCategory Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  label            String?
  /// The item, how many, its price and the percent; amount is worked out
  /// from them. Null on lines saved before they were asked for.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity  Int?
  unitPrice Decimal? @db.Decimal(12, 2)
  percent   Decimal? @db.Decimal(6, 2)
  amount    Decimal  @db.Decimal(12, 2)

  @@index([paymentId])
}

/// Money the Owner loads into the main Telebirr balance.
model TelebirrLoad {
  id String @id @default(cuid())

  amount Decimal @db.Decimal(14, 2)
  note   String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Telebirr money a seller spent: CASH_IN (customer paid cash, got Telebirr
/// money) or AIRTIME (airtime sold from Telebirr). Both come off the balance.
model TelebirrTransaction {
  id String @id @default(cuid())

  kind   String
  amount Decimal @db.Decimal(14, 2)

  locationId String
  location   StockLocation @relation(fields: [locationId], references: [id])

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  customerPhone String?
  note          String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([locationId])
  @@index([recordedById])
}

/// A category of goods the Owner manages: SIM Cards, Phones, Airtime, and any
/// they add. `kind` decides how its goods behave; added ones are OTHER.
model Category {
  id String @id @default(cuid())

  name     String          @unique
  kind     ProductCategory
  isActive Boolean         @default(true)

  types    ProductType[]
  products Product[]
  commissionLines CommissionLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Money a branch paid out (transport, repairs, supplies...), recorded by its
/// supervisor with a reason. The Owner reads these as a report.
model Expense {
  id String @id @default(cuid())

  locationId String
  location   StockLocation @relation(fields: [locationId], references: [id])

  amount Decimal @db.Decimal(12, 2)
  reason String
  note   String?

  /// The day it was spent, which may be before it was typed in.
  expenseDate DateTime

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([locationId])
  @@index([expenseDate])
}

/// A batch of National ID customers a salesperson sent for printing (ORIGINAL)
/// or copying (COPY): WITH_SUPERVISOR, then WITH_OWNER, then RETURNED with how
/// many were done and how many were left over.
model NationalIdRequest {
  id String @id @default(cuid())

  kind   String
  status String @default("WITH_SUPERVISOR")

  locationId String
  location   StockLocation @relation(fields: [locationId], references: [id])

  requestedById String
  requestedBy   User   @relation("NidRequested", fields: [requestedById], references: [id])

  total         Int
  doneCount     Int?
  leftoverCount Int?
  note          String?

  forwardedById String?
  forwardedBy   User?     @relation("NidForwarded", fields: [forwardedById], references: [id], onDelete: SetNull)
  forwardedAt   DateTime?

  returnedById String?
  returnedBy   User?     @relation("NidReturned", fields: [returnedById], references: [id], onDelete: SetNull)
  returnedAt   DateTime?

  orders NationalIdOrder[]

  createdAt DateTime @default(now())

  @@index([locationId])
  @@index([status])
}

/// One customer waiting for a National ID print (ORIGINAL) or copy (COPY), at
/// the price in force when registered.
model NationalIdOrder {
  id String @id @default(cuid())

  kind     String
  fullName String
  price    Decimal @db.Decimal(12, 2)
  status   String  @default("REGISTERED")

  locationId String
  location   StockLocation @relation(fields: [locationId], references: [id])

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  requestId String?
  request   NationalIdRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([locationId])
  @@index([status])
  @@index([requestId])
}
